# Copy this file to ".env" and paste in your own API-Sports key.
# Get a free key at https://dashboard.api-football.com/register
#
# The ".env" file is git-ignored so your key is never committed.

# --- Local development ----
# Used by `npm run dev`. Vite only exposes variables prefixed with "VITE_",
# so this key IS sent from the browser — that is fine for local dev only.
VITE_API_FOOTBALL_KEY=your_api_key_here

# --- Production (deployment) ---
# When deployed to Vercel, the browser instead calls the /api/football proxy,
# which reads this SERVER-side variable (no VITE_ prefix = never sent to the
# browser). Set it in your host's Environment Variables dashboard, not here.
# API_FOOTBALL_KEY=your_api_key_here
